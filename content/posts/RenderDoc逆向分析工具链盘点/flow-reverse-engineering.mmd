flowchart TD
    classDef proc fill:#e1f5fe,color:#000
    classDef io fill:#fff3e0,color:#000
    classDef gate fill:#fff9c4,color:#000
    classDef fix fill:#ffebee,color:#000
    classDef result fill:#e8f5e9,color:#000

    START["capture + API + EID + stage"]:::io --> LOCATE["定位 draw / dispatch<br/>读取 shader、管线与绑定"]:::proc
    LOCATE --> EVID["cbuffer 原始值、描述符<br/>贴图与 RT / UAV 内容"]:::io
    LOCATE --> BASE["选择对应 API 的反编译链<br/>化简并检查 baseline"]:::proc
    BASE --> HASH["登记 baseline<br/>project.json 中记录 EID、stage、SHA-256"]:::proc
    HASH --> SEM["语义重命名 / 可读化 / 转述<br/>保持绑定、布局与算法约束"]:::proc
    HASH -. "登记只核对文件身份" .-> COMPARE
    EVID -. "交叉印证" .-> SEM
    SEM --> COMPILE["按目标 API 编译<br/>DXBC / DXIL / SPIR-V"]:::proc
    COMPILE --> PROVE["按对应验证器检查替换生效证据<br/>D3D：canary 与 PSO 错误检查<br/>SPIR-V：覆盖与重注入自检"]:::gate
    PROVE --> EFFECT{"生效证据充分?"}:::gate
    EFFECT -- 否 --> BLOCK["FAIL 或 BLOCKED<br/>排查替换、PSO、输出覆盖"]:::fix
    BLOCK --> COMPILE
    EFFECT -- 是 --> COMPARE["同一 capture / EID 下运行对应验证器<br/>比较登记的 baseline 与目标结果<br/>记录覆盖、资源、容差与差异"]:::gate
    COMPARE --> OK{"本次比较通过?"}:::gate
    OK -- 否 --> REPAIR["定位绑定、编译或改写差异"]:::fix
    REPAIR --> SEM
    OK -- 是 --> REPORT["保存报告和产物身份<br/>说明验证覆盖与限制"]:::result
    REPORT --> ARTICLE["语义清单与文章素材装配<br/>检查文件引用及哈希闭合"]:::result
    REPORT --> UNITY["Unity 模板装配与算法适配<br/>在 Unity 中再次核对画面"]:::proc
